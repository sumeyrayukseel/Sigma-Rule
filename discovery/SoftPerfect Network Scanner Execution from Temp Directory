title: SoftPerfect Network Scanner Execution from Temp Directory
status: experimental
description: Detects execution of netscan.exe from a temporary directory, which may indicate network discovery activity.
references:
    - https://thedfirreport.com/2026/05/11/flash-alert-etherrat-and-tuktuk-c2-end-in-the-gentleman-ransomware/
author: Sümeyra Yüksel
date: 2026/10/21
tags:
    - attack.discovery
    - attack.t1046
logsource:
    category: process_creation
    product: windows
detection:
    selection_img:
        - Image|endswith:
              - '\netscan.exe'
              - '\netscan64.exe'
        - Company|contains: 'SoftPerfect'
    selection_path:
        Image|contains:
            - '\Temp\'
            - '\AppData\'
            - '\Users\Public\'
    condition: all of selection_*
fields:
    - Image
    - ParentImage
    - CommandLine
    - Company
    - User
falsepositives:
    - Administrators running the scanner portably from a user-writable folder
level: medium
