title: Suspicious Analysis Environment Discovery Using LOLBins
status: experimental
description: Detects selected LOLBins with command-line indicators associated with virtualization or sandbox discovery.
references:
    - https://thedfirreport.com/2022/09/26/bumblebee-round-two/
author: Sümeyra Yüksel
date: 2026/10/27
tags:
    - attack.discovery
    - attack.t1497
logsource:
    category: process_creation
    product: windows
detection:
    selection_image:
        Image|endswith:
            - '\reg.exe'
            - '\rundll32.exe'
            - '\wmic.exe'
            - '\powershell.exe'
            - '\cmd.exe'
    selection_keywords:
        CommandLine|contains:
            - 'VirtualBox'
            - 'VMware'
            - 'QEMU'
            - 'Sandbox'
            - 'VBox'
    condition: all of selection_*
falsepositives:
    - Legitimate virtualization inventory and troubleshooting
level: medium
