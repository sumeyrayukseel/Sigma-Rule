title: ProcDump Used to Dump LSASS Memory
status: experimental
description: Detects procdump targeting lsass.exe with a memory dump switch
references:
    - https://thedfirreport.com/2022/09/26/bumblebee-round-two/
author: Sümeyra Yüksel
date: 2026/10/27
tags:
    - attack.credential-access
    - attack.t1003.001
logsource:
  category: process_creation
  product: windows
detection:
  selection_img:
    - Image|endswith: ['\procdump.exe', '\procdump64.exe']
    - OriginalFileName: 'procdump'
  selection_cli:
    CommandLine|contains: 'lsass'
    CommandLine|contains|windash:
      - ' -ma '
      - ' -mm '
      - ' -mp '
  condition: selection_img and selection_cli
falsepositives:
  - Authorized troubleshooting by administrators
level: high
