title: NetExec SMB Lsassy Credential Dumping
status: experimental
description: Detects NetExec SMB activity invoking the Lsassy module, which may indicate an attempt to extract credentials from the LSASS process on a remote Windows system.
references:
    - https://thedfirreport.com/2026/05/11/flash-alert-etherrat-and-tuktuk-c2-end-in-the-gentleman-ransomware/
author: Sümeyra Yüksel
date: 2026/10/21
modified: 2026/10/25
tags:
    - attack.credential-access
    - attack.t1003.001
logsource:
    category: process_creation
    product: windows
detection:
    selection_tool:
        - Image|endswith:
              - '\nxc.exe'
              - '\netexec.exe'
        - CommandLine|contains:
              - 'nxc'
              - 'netexec'
    selection_cli:
        CommandLine|contains|all:
            - ' smb '
            - '-M lsassy'
    condition: all of selection_*
fields:
    - Image
    - ParentImage
    - CommandLine
    - User
falsepositives:
    - Authorized penetration tests using NetExec
level: medium
