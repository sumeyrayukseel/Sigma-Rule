
title: Suspicious Chrome Headless File Download
id: 6e8c2f41-9a73-4d50-b126-5f7a3c8d2049
description: Detects potential file downloads using headless Chrome with logging and DOM dumping options.
author: Sümeyra Yüksel
status: experimental
date: 2026/10/28
tags:
    - attack.command-and-control
    - attack.t1105
logsource:
    product: windows
    category: process_creation
detection:
    selection:
        CommandLine|contains|all:
            - 'chrome.exe'
            - '--headless'
            - '--enable-logging'
            - '--disable-gpu'
            - '--dump-dom'
            - 'http'
            - 'out.'
    condition: selection
fields:
    - Image
    - ParentImage
    - CommandLine
falsepositives:
    - Legitimate headless Chrome automation or testing
level: medium
