title: Executable Created in Temp by Downloads Process
status: experimental
description: Detects an executable created in a user temporary directory by a process running from Downloads, which may indicate suspicious payload staging.
tags:
    - attack.execution
logsource:
    category: file_event
    product: windows
    service: sysmon
detection:
    selection_target:
        TargetFilename|contains: '\AppData\Local\Temp\'
        TargetFilename|endswith: '.exe'
    selection_parent:
        Image|contains: '\Downloads\'
    condition: all of selection_*
    EventID: 11 
fields:
    - Image
    - TargetFilename
    - User
level: medium
