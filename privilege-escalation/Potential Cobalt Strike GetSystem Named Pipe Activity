title: Potential Cobalt Strike GetSystem Named Pipe Activity
status: experimental
description: Detects cmd.exe echo commands redirecting data to a Windows named pipe, a behavior reported in association with Cobalt Strike GetSystem privilege escalation.
    - attack.privilege-escalation

logsource:
    category: file_event
    product: windows
    service: sysmon
detection:
    selection:
        Image|endswith: '\cmd.exe'
        CommandLine|contains|all:
            - 'echo '
            - '\\.\pipe\'
    condition: selection
fields:
    - Image
    - TargetFilename
    - User
level: medium
