title: Renamed Windows Address Book (WAB.EXE) Execution
status: experimental
description: Detects execution of a binary whose OriginalFileName is WAB.EXE but whose image name is not wab.exe. Attackers rename WAB.exe and inject shellcode into it; observed with AdaptixC2 delivered via a renamed copy (AdgNsy.exe).
references:
    - https://thedfirreport.com/2026/06/29/from-bing-search-to-ransomware-bumblebee-and-adaptixc2-deliver-akira-3/
author: Sümeyra Yüksel
date: 2026/10/19
tags:
    - attack.defense_evasion
    - attack.t1036.003
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        OriginalFileName: 'WAB.EXE'
    filter_main_legit_name:
        Image|endswith:
            - '\wab.exe'
            - '\wabmig.exe'
    condition: selection and not filter_main_legit_name
fields:
    - Image
    - ParentImage
    - CommandLine
    - ParentCommandLine
    - OriginalFileName
falsepositives:
    - Unknown
level: high
