title: Network Connection from WAB or ImagingDevices (Injection Host)
status: experimental
description: These binaries normally make no outbound connections; a connection suggests injected C2 payload
references:
    - https://thedfirreport.com/2022/09/26/bumblebee-round-two/
author: Sümeyra Yüksel
date: 2026/10/26
tags: 
- attack.defense_evasion
- attack.t1055
logsource:
  category: network_connection
  product: windows
detection:
  selection:
    Initiated: 'true'
    Image|endswith:
      - '\wab.exe'
      - '\wabmig.exe'
      - '\ImagingDevices.exe'
  condition: selection
falsepositives:
  - Very rare
level: high
